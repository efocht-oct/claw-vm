# Per-VM configuration example for claw-vmctl.
# Save this file as:
#   <BASE_DIR>/vms/<vm-id>/.env
# where <BASE_DIR> defaults to $HOME/ubuntu24-qemu-claw,
# or can be overridden with CLAW_VM_BASE_DIR / --base-dir.

VM_ID="dev1"
VM_NAME="noble-claw-dev1"
VM_USER="claw"

# VM resources
RAM_MB=4096
CPUS=2
DISK_GB=30

# Networking
# Leave BRIDGE empty for NAT mode; set e.g. BRIDGE="br0" for bridged mode.
BRIDGE=""
SSH_FWD_PORT=2222
QEMU_VNC_PORT=5901

# SSH public key (optional; fallback: ~/.ssh/id_rsa.pub or ~/.ssh/id_ed25519.pub)
# SSH_PUBKEY="ssh-ed25519 AAAA..."
